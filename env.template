# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase credentials

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Unstructured.io API (optional - for better PDF/DOCX chunking)
# Get free API key at: https://unstructured.io/api-key-hosted
UNSTRUCTURED_API_KEY=

# --- Optional model / retrieval overrides ------------------------------------
# All of these have defaults in src/lib/ai/config.ts. Set them only to deviate.

# Chat model used to generate answers.
# GEMINI_CHAT_MODEL=gemini-3.6-flash

# Embedding model. Changing this invalidates every stored vector.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Vector dimensionality. MUST match vector(N) on embeddings.embedding in
# Postgres - see supabase/migrations/. Changing it needs a migration + re-embed.
# GEMINI_EMBEDDING_DIMENSIONS=1536

# Minimum cosine similarity for a chunk to be used as a source. Calibrated for
# gemini-embedding-2 at 1536 dims. Raise to be stricter, lower to recall more.
# RAG_MATCH_THRESHOLD=0.6

# Maximum chunks retrieved per question.
# RAG_MATCH_COUNT=8
